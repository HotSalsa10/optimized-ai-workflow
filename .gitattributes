# LF everywhere so scripts behave the same on Windows, macOS, Linux and cloud sessions.
* text=auto eol=lf

# Windows command scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary formats: never convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.xlsx binary
*.docx binary
*.pptx binary
